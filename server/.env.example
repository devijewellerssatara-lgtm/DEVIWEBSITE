# Example .env for the Rates API server

# Postgres connection string:
# - Local example: postgres://user:password@localhost:5432/mydb
# - Render/Neon/Heroku example usually provided by the provider
DATABASE_URL=postgres://user:password@localhost:5432/mydb

# When using managed Postgres that requires SSL, set:
# PGSSLMODE=require
# Otherwise leave it unset for local dev
# PGSSLMODE=require

# Port for the API server
PORT=5000