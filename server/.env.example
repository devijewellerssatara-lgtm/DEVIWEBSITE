# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=jewellery
PGUSER=postgres
PGPASSWORD=postgres

# Server
PORT=5000

# Firebase Admin (Service Account) JSON file path for migration
# Place your service account JSON in server/ and set its filename here
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_PROJECT_ID=your-project-id